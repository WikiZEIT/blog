{%- comment %}
  Shared body for the Wikipedia book-search tool. Both the Polish (`index.liquid`)
  and English (`en.liquid`) pages include this; they differ only in front matter.
  The active language is taken from the `lang` variable in scope and looked up in
  the global `books` data (src/_data/books.json).
{% endcomment -%}
{%- assign t = books.languages[lang] -%}
<?php
// Values baked in from books.json at build time. The `| default:` fallbacks keep
// this valid PHP even if the data ever goes missing (otherwise an empty value
// would bake `$var = ;` and fatal-error the page).
$BOOKS_PATH        = {{ t.path | default: page.url | jsonify }};
$BOOKS_TRACK_TITLE = {{ t.seo.title | default: title | jsonify }};

require_once $_SERVER['DOCUMENT_ROOT'] . '/api/lib/umami.php';

// NOTE: no language/geo redirect. Each language is a stable, self-canonical 200
// page cross-linked with hreflang; auto-redirecting the canonical URL would make
// it look like a redirect to crawlers (and would redirect bots). Language choice
// is offered via the switcher below. See src/tools/books/README.md.

// Google Books proxy (shared by every language page; the API key lives once at
// the canonical /tools/books/config.json, resolved via the document root).
if (isset($_GET['api'])) {
    while (ob_get_level()) ob_end_clean();
    header('Content-Type: application/json; charset=utf-8');
    $configPath = $_SERVER['DOCUMENT_ROOT'] . '/tools/books/config.json';
    $apiKey = file_exists($configPath) ? json_decode(file_get_contents($configPath)) : null;
    if (!$apiKey) {
        http_response_code(500);
        echo json_encode(['error' => 'API key not configured']);
        exit;
    }
    $query = isset($_GET['q']) ? trim($_GET['q']) : '';
    if (!$query) {
        http_response_code(400);
        echo json_encode(['error' => 'Missing query parameter']);
        exit;
    }
    $params = [
        'q' => $query,
        'key' => $apiKey,
    ];
    if (!empty($_GET['quotaUser'])) {
        $params['quotaUser'] = $_GET['quotaUser'];
    }
    $url = 'https://www.googleapis.com/books/v1/volumes?' . http_build_query($params);
    $ctx = stream_context_create(['http' => ['ignore_errors' => true]]);
    $response = @file_get_contents($url, false, $ctx);
    $status = 0;
    if (isset($http_response_header[0]) && preg_match('/\s(\d{3})\s/', $http_response_header[0], $m)) {
        $status = (int)$m[1];
    }
    if ($status >= 200 && $status < 300 && $response) {
        echo $response;
    } else {
        http_response_code($status ?: 502);
        echo $response ?: json_encode(['error' => 'API request failed']);
    }
    exit;
}

umami_track($BOOKS_PATH, $BOOKS_TRACK_TITLE, $_SERVER['HTTP_REFERER'] ?? '');
?>
<main id="main-content" class="book-tool">
    <noscript>
        <div class="noscript-warning">{{ t.ui.noscript }}</div>
    </noscript>
    <nav class="book-lang-switcher" aria-label="Language">
        {%- for l in books.languages -%}
          {%- assign code = l[0] -%}{%- assign conf = l[1] -%}
          {%- if code == lang -%}
            <a href="{{ conf.path }}" hreflang="{{ code }}" class="active" aria-current="true">{{ conf.name }}</a>
          {%- else -%}
            <a href="{{ conf.path }}" hreflang="{{ code }}">{{ conf.name }}</a>
          {%- endif -%}
        {%- endfor -%}
    </nav>
    <h1>{{ t.ui.title }}</h1>
    <p class="tool-desc">{{ t.ui.description }}</p>
    {%- assign toolSourceLabel = t.ui.source -%}
    {%- assign toolLicenseLabel = t.ui.license -%}
    {% include "partials/tool-meta.liquid" %}

    <div class="book-search-card">
        <form class="book-search-box">
            <input type="text" name="q" placeholder="{{ t.ui.placeholder }}">
            <button type="submit">{{ t.ui.search }}</button>
        </form>
        <div class="book-format-toggle">
            <a href="#" class="book-format-link active" data-format="cytuj_ksiazke">{{ t.templates.cytuj_ksiazke.name }}</a>
            <a href="#" class="book-format-link" data-format="cytuj">{{ t.templates.cytuj.name }}</a>
            {%- if t.odn %}
            <label class="book-odn-toggle checkbox"><input type="checkbox" id="book-odn" checked> {{ t.ui.odnLabel }}</label>
            {%- endif %}
        </div>
    </div>

    <div id="book-results"></div>
</main>
<script>window.BOOKS_CFG = {{ t | jsonify }};</script>
<?php if (isset($_GET['_debug'])): ?>
<script>window.BOOKS_MOCK = {{ books.mock | jsonify }};</script>
<?php endif; ?>
{% assign booksJsHash = "/js/books.js" | contentHash %}<script src="/js/books.js?v={{ booksJsHash }}"></script>
